#!/bin/sh
# UHC pre-commit hook: runs Android Lint before every commit.
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (emergencies only): git commit --no-verify

# Only lint when source, resource or build files are staged.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(java|kt|xml|kts|toml)$'; then
  exit 0
fi

echo "pre-commit: running Android Lint (:app:lintDebug)..."
if ! ./gradlew :app:lintDebug --quiet; then
  echo ""
  echo "pre-commit: Lint found errors - commit blocked."
  echo "Report: app/build/reports/lint-results-debug.html"
  exit 1
fi
echo "pre-commit: lint passed."
