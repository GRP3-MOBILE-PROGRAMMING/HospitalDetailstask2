<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/uhc_background">
 <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp" android:paddingBottom="28dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
     <TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sarah Namusoke" android:textColor="@color/uhc_text" android:textSize="25sp" android:textStyle="bold"/>
     <TextView android:id="@+id/detail_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Patient ID: UHC-001  ·  Female, 34 years" android:textColor="@color/uhc_muted" android:textSize="13sp"/>
    </LinearLayout>
    <ImageView android:id="@+id/detail_photo" android:layout_width="88dp" android:layout_height="88dp" android:layout_marginStart="12dp" android:background="@drawable/uhc_avatar_outline" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="Patient portrait"/>
   </LinearLayout>
   <TextView android:id="@+id/detail_status" android:layout_width="150dp" android:layout_height="34dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:paddingStart="16dp" android:background="@drawable/uhc_status" android:text="ACTIVE RECORD" android:textColor="@color/uhc_green" android:textStyle="bold" android:textSize="12sp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="PATIENT SUMMARY" android:textColor="@color/uhc_text" android:textSize="14sp" android:textStyle="bold"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="8dp" android:padding="16dp" android:orientation="horizontal" android:background="@drawable/uhc_summary">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Blood group" android:textColor="@color/uhc_muted" android:textSize="12sp"/><TextView android:id="@+id/detail_blood_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="O+" android:textColor="@color/uhc_text" android:textStyle="bold" android:textSize="16sp"/></LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Last visit" android:textColor="@color/uhc_muted" android:textSize="12sp"/><TextView android:id="@+id/detail_last_visit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="12 Oct 2026" android:textColor="@color/uhc_text" android:textStyle="bold" android:textSize="16sp"/></LinearLayout>
   </LinearLayout>
   <include layout="@layout/section_medical_history"/>
   <include layout="@layout/section_medications"/>
   <include layout="@layout/section_allergies"/>
   <include layout="@layout/section_vitals"/>
   <TextView android:id="@+id/detail_full_history" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="26dp" android:gravity="center" android:background="@drawable/uhc_button" android:text="VIEW FULL MEDICAL HISTORY" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
